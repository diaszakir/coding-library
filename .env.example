# Copy this file to .env before running Docker Compose.
# Use 127.0.0.1 to keep Docker available only on this computer, or 0.0.0.0
# to open it to devices on the local network.
DEVLIBRARY_BIND_ADDRESS=127.0.0.1
DEVLIBRARY_PORT=3000
DEVLIBRARY_ALLOW_NETWORK=false

# Native Node.js startup (pnpm dev / pnpm start); Docker uses its own values.
DEVLIBRARY_HOST=127.0.0.1
PORT=3000
# DEVLIBRARY_DATA_DIR=/absolute/path/to/library-data
# DEVLIBRARY_SEED=empty
